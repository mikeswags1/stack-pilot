{
  "alias": ["stackpilot-app.vercel.app"],
  "functions": {
    "app/api/ebay/list-product/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/refresh-products/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/auto-listing-tick/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/source-agent/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/reprice-agent/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/fulfillment-agent/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/digest-agent/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/niche-lifecycle/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/outcome-tracker/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/source-graph/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/replenish-ready-queue/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/demand-scout/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-products?sourceOnly=1&autopilot=1&repairBatch=8&auditLimit=60",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/refresh-products?stockWeak=1&wait=1&batch=10&auditLimit=60",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/refresh-products?backgroundCatalog=1&wait=1&batch=4&auditLimit=60",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/refresh-products?full=1&wait=1&auditLimit=60",
      "schedule": "0 */8 * * *"
    },
    {
      "path": "/api/cron/auto-listing-tick?limit=40",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/source-agent",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reprice-agent",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/fulfillment-agent",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/digest-agent",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/niche-lifecycle",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/outcome-tracker?engagementLimit=25",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/source-graph",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/replenish-ready-queue?platformTarget=300&rawTarget=5000",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/demand-scout?seedsPerRun=6&perSeed=15",
      "schedule": "0 13,21 * * *"
    }
  ]
}
